# Non-secret configuration for the LEO Classroom stack. Copy to `.env` and edit.
# SECRETS NEVER GO HERE — Tier-1 secrets are Podman secrets created by ./init-secrets.sh.

# Single school-local timezone honored by BOTH Forgejo and the backend (deadline math, §9).
TZ=Europe/Vienna

# --- Public addresses fronted by Caddy -------------------------------------------------------------
# http or https. Use http when the server is reachable only by IP: no CA issues certificates for a bare
# address, so automatic HTTPS cannot work and Caddy would fail to start a TLS site.
PUBLIC_SCHEME=http

# Caddy site addresses. A bare port serves every Host header, which is what an IP-only deployment wants and
# what keeps the site reachable through an SSH tunnel or VS Code port-forward. With a real hostname use the
# full form instead, so Caddy can obtain a certificate:
#   IP only:   APP_SITE=:80                              FORGEJO_SITE=:3000
#   hostname:  APP_SITE=https://classroom.school.example  FORGEJO_SITE=https://forgejo.school.example
APP_SITE=:80
FORGEJO_SITE=:3000

# The addresses the application advertises: the CORS allow-list, the accept links mailed to students, and
# the clone URLs Forgejo hands out. These are what users type, so they carry the port when there is one.
#   hostname:  APP_DOMAIN=classroom.school.example   FORGEJO_DOMAIN=forgejo.school.example  FORGEJO_PORT=443
#   IP only:   APP_DOMAIN=10.191.18.44              FORGEJO_DOMAIN=10.191.18.44:3000       FORGEJO_PORT=3000
APP_DOMAIN=10.191.18.44
FORGEJO_DOMAIN=10.191.18.44:3000
FORGEJO_PORT=3000
# Host part of FORGEJO_DOMAIN without the port; Forgejo wants the bare name.
FORGEJO_HOST=10.191.18.44

# TLS: only used when a site address above uses https. Edit the (tls_config) snippet in the Caddyfile to
# switch modes; public ACME (the default) uses this email, internal CA / provided certs ignore it.
# Do not leave it blank - Caddy rejects an `email` directive with no argument. compose supplies a dummy
# default if it is unset entirely.
ACME_EMAIL=admin@school.example
# Directory mounted into caddy at /etc/caddy/certs when using operator-provided certificates.
TLS_CERT_DIR=./certs

# --- Keycloak (the school's shared instance; NOT started by this stack) -----------------------------
# Issuer URL of the realm; must match the `iss` claim of the tokens exactly.
KEYCLOAK_AUTHORITY=https://auth.htl-leonding.ac.at/realms/htlleonding
# Browser-facing base URL (no /realms suffix), realm and the client the SPA logs in with. The school uses
# one shared client for both the SPA and the API.
KEYCLOAK_URL=https://auth.htl-leonding.ac.at
KEYCLOAK_REALM=htlleonding
KEYCLOAK_FRONTEND_CLIENT_ID=htlleonding-service

# The realm does not put an `aud` on its access tokens, so audience validation must stay off; issuer,
# signature and lifetime are verified regardless. Set both only against a realm that does issue one.
KEYCLOAK_AUDIENCE=htlleonding-service
KEYCLOAK_VALIDATE_AUDIENCE=false

# The realm's shared client returns 401 when the standard flow exchanges the auth code, so the SPA uses
# the implicit flow (this is what the school's own Angular demo does).
KEYCLOAK_FLOW=implicit

# --- Administrators --------------------------------------------------------------------------------
# The realm expresses only students and teachers - there is no admin role to read from a token - so this
# application names its own by username (the `preferred_username` / IF number). Everyone listed here gets
# the audit log, the LDAP sync trigger and permanent user deletion. Add more as ADMIN_USER_2, ... in
# compose.yaml alongside the existing two.
ADMIN_USER_0=if000000
ADMIN_USER_1=

# --- Forgejo ---------------------------------------------------------------------------------------
# The bot account the backend acts as. Its API token is the Forgejo__AdminToken secret.
FORGEJO_BOT_NAME=leo-classroom-bot
FORGEJO_BOT_EMAIL=bot@school.example
# Id of the Forgejo login source accounts are bound to, from `forgejo admin auth list`.
# Leave 0: the backend then creates Forgejo accounts itself and issues each user a random password on their
# account page (DECISIONS.md). Set it only to hand login over to LDAP or Keycloak, after which the app stops
# managing passwords - see DEPLOY.md step 7.
FORGEJO_AUTH_SOURCE_ID=0

# --- Database names/users (passwords are Tier-1 secrets, not here) ----------------------------------
BACKEND_DB_NAME=leoclassroom
BACKEND_DB_USER=leoclassroom
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo

# --- LDAP directory sync (optional) ----------------------------------------------------------------
# Leave LDAP_HOST empty to run without it: the nightly sync then logs a failed read and changes nothing.
# The bind password is the Ldap__BindPassword secret.
LDAP_HOST=
LDAP_PORT=636
# None | Ldaps | StartTls — a simple bind is refused over an unencrypted connection.
LDAP_TLS_MODE=Ldaps
LDAP_BIND_DN=
LDAP_STUDENT_BASE_DN=ou=students,dc=school,dc=local
LDAP_TEACHER_BASE_DN=ou=teachers,dc=school,dc=local

# --- Outgoing mail (optional) ----------------------------------------------------------------------
# Leave SMTP_HOST empty to run without notification mail; queued notifications retry and stay pending.
# The password is the Smtp__Password secret.
SMTP_HOST=
SMTP_PORT=25
# None | StartTlsWhenAvailable | StartTls | SslOnConnect
SMTP_SECURITY=StartTlsWhenAvailable
SMTP_FROM_ADDRESS=no-reply@school.example
SMTP_FROM_NAME=LEO Classroom
SMTP_USERNAME=

# --- Backup schedule + restic offsite repository and retention (credentials are Tier-1 secrets) -----
BACKUP_CRON=0 2 * * *
RESTIC_REPOSITORY=s3:https://s3.example.com/leo-classroom-backups
RESTIC_RETENTION=--keep-daily 7 --keep-weekly 4 --keep-monthly 6

# --- Persistent volumes ----------------------------------------------------------------------------
# forgejo_data, forgejo_db_data, backend_db_data and caddy_data are `external: true` in compose.yaml so that
# no compose command can delete them. Their real names are <VOLUME_PREFIX>_<volume>, and the default matches what
# compose itself would have created in a directory called "leoclassrooms". Change this only if
# `podman volume ls` shows a different prefix - it is the compose project name, i.e. the directory name.
VOLUME_PREFIX=leoclassrooms

# --- SPA session --------------------------------------------------------------------------------------
# Minutes of inactivity before the SPA logs the user out. Restarting the frontend container applies it; no
# rebuild. This is the only session limit this deployment controls - the access token lifespan and the SSO
# session's idle and maximum lifetimes are the realm's, and under the implicit flow there is no refresh
# token, so a session can still end sooner than this.
SESSION_TIMEOUT_MINUTES=360
