<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>exe</OutputType>
        <!-- The installed SDK (11.0.100-rc.3) fails JS-module endpoint validation for Web-SDK test
             projects ("scoped css bundles do not have matching endpoints"). These tests serve no
             static assets, so the pipeline is not needed here; drop this once the SDK is fixed. -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\LeoClassroom.Persistence\LeoClassroom.Persistence.csproj"/>
        <ProjectReference Include="..\LeoClassroom\LeoClassroom.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0"/>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11"/>
        <PackageReference Include="NSubstitute" Version="6.2.0"/>
        <PackageReference Include="xunit.v3" Version="4.0.0"/>
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0"/>
    </ItemGroup>
    <ItemGroup>
        <Using Include="AwesomeAssertions"/>
        <Using Include="Xunit"/>
    </ItemGroup>
</Project>
