{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console"
        ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft.EntityFrameworkCore.Database.Command": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "Startup": {
        "VerifySchemaOnStartup": false
    },
    "General": {
        "ClientOrigin": "http://localhost:4200"
    },
    "Keycloak": {
        "Authority": "http://localhost:8080/realms/leo-classroom",
        "Audience": "leo-classroom-backend",
        "RequireHttpsMetadata": false
    },
    "Forgejo": {
        "BaseUrl": "http://localhost:3000",
        "BotName": "leo-classroom-bot",
        "BotEmail": "bot@leoclassroom.local",
        "AdminToken": "dev-admin-token",
        "WebhookSecret": "dev-webhook-secret",
        "WebhookTargetUrl": "http://localhost:5080/api/webhooks/forgejo"
    }
}
