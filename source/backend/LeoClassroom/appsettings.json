{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "/var/log/leo-classroom/leoclassroom-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": "30",
                    "fileSizeLimitBytes": "104857600",
                    "rollOnFileSizeLimit": true,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "Startup": {
        "VerifySchemaOnStartup": true
    },
    "General": {
        "ClientOrigin": "https://app.leoclassroom.local"
    },
    "Keycloak": {
        "Authority": "https://keycloak.leoclassroom.local/realms/leo-classroom",
        "Audience": "leo-classroom-backend",
        "RequireHttpsMetadata": true
    },
    "Forgejo": {
        "BaseUrl": "https://git.leoclassroom.local",
        "BotName": "leo-classroom-bot",
        "BotEmail": "bot@leoclassroom.local",
        "AdminToken": "",
        "WebhookSecret": "",
        "WebhookTargetUrl": "https://api.leoclassroom.local/api/webhooks/forgejo",
        "AuthSourceId": 0
    },
    "Ldap": {
        "Host": "ldap.leoclassroom.local",
        "Port": 636,
        "TlsMode": "Ldaps",
        "BindDn": "",
        "BindPassword": "",
        "StudentBaseDn": "ou=students,dc=school,dc=local",
        "TeacherBaseDn": "ou=teachers,dc=school,dc=local",
        "SearchFilter": "(objectClass=person)",
        "PageSize": 500,
        "StudentIdAttribute": "uid",
        "GivenNameAttribute": "givenName",
        "FamilyNameAttribute": "sn",
        "MailAttribute": "mail",
        "ClassAttribute": "ou",
        "SoftDeleteThreshold": 50,
        "NightlyCron": "0 0 2 * * ?"
    },
    "Audit": {
        "RetentionYears": 5,
        "RetentionCron": "0 0 3 * * ?"
    },
    "Smtp": {
        "Host": "localhost",
        "Port": 25,
        "Security": "StartTlsWhenAvailable",
        "FromAddress": "no-reply@leoclassroom.local",
        "FromName": "LEO Classroom",
        "Username": "",
        "DefaultLanguage": "en",
        "AppBaseUrl": "https://localhost",
        "MaxAttempts": 5,
        "BaseBackoffSeconds": 60,
        "PollSeconds": 10,
        "BatchSize": 50
    },
    "Moodle": {
        "CreateFunction": "local_leoclassroom_create_item",
        "UpdateFunction": "local_leoclassroom_update_item",
        "DeleteFunction": "local_leoclassroom_delete_item",
        "AppBaseUrl": "https://localhost",
        "MaxAttempts": 5,
        "BaseBackoffSeconds": 60,
        "OutboxDrainSeconds": 15,
        "BatchSize": 50,
        "BackfillCron": "0 0 4 * * ?"
    },
    "DataProtection": {
        "MasterKey": ""
    },
    "Download": {
        "ArtifactStoragePath": "/var/lib/leo-classroom/downloads",
        "ArtifactTtlHours": 24,
        "MaxRepos": 500,
        "MaxTotalSizeBytes": 2147483648,
        "DrainSeconds": 10,
        "CleanupCron": "0 15 * * * ?"
    },
    "ConnectionStrings": {
        "Postgres": "Host=localhost;Database=postgres;Username=postgres;Password=postgres"
    }
}
