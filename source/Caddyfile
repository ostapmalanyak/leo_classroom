# Caddy is the ONLY externally bound service. It terminates TLS at the edge and proxies to the
# backend, frontend, and Forgejo over the internal `leo` network. Git is HTTPS-only (no SSH anywhere).

{
	# Used by the public-ACME TLS mode below.
	email {$ACME_EMAIL}
}

# APP_SITE / FORGEJO_SITE are Caddy site addresses, not host names.
#
# A bare port (`:80`) listens on that port and serves every request regardless of the Host header. That is
# what an IP-only deployment wants: there is no virtual hosting to do, and it keeps the site reachable
# through an SSH tunnel or port-forward, where the browser sends `localhost:<port>` and a host-matched
# site block would answer nothing at all.
#
# With a real hostname use the full form - `https://classroom.school.example` - so that Caddy knows which
# certificate to obtain and redirects HTTP to HTTPS for you.
#
# --- TLS mode (selectable by configuration) -------------------------------------------------------
# Default (this empty snippet) = automatic HTTPS via public ACME using the global email above.
# Internal CA:      replace the snippet body with:  tls internal
# Provided certs:   replace the snippet body with:  tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
(tls_config) {
}

# --- Classroom app: frontend SPA + /api backend ---------------------------------------------------
{$APP_SITE} {
	import tls_config
	encode gzip

	# Preserve the /api prefix — the backend's endpoint groups are routed under /api.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# The backend's liveness endpoint, so it can be probed from outside as well as by the container
	# healthcheck. Without this it falls through to the SPA below, which answers index.html to everything.
	handle /healthz {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}

# --- Forgejo -------------------------------------------------------------------------
{$FORGEJO_SITE} {
	import tls_config

	# Forgejo trusts X-WEBAUTH-USER as proof of login (reverse-proxy authentication), so a client must never
	# be able to supply it. Drop every inbound copy before anything else runs; only the forward_auth step
	# below may set it.
	request_header -X-WEBAUTH-USER
	request_header -X-WEBAUTH-EMAIL
	request_header -X-WEBAUTH-FULLNAME

	# oauth2-proxy's own endpoints: sign-in start, Keycloak callback, sign-out.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	# Git over HTTPS and the REST API authenticate with a password or token, which is the only thing a git
	# client or the backend can present; Forgejo's proxy login does not cover them, and an SSO redirect would
	# break them. They go straight through, without the login header.
	#
	# Only the git protocol's own endpoints are listed, not every `*.git` path: the link the app shows
	# students is the bare `.../repo.git` URL, which a browser opens, and Forgejo answers an anonymous
	# request for a private repository with 404. That one must go through the sign-in below, after which
	# Forgejo redirects it to the repository page.
	@machine {
		expression {path}.startsWith("/api/") || {path}.matches("^/[^/]+/[^/]+\\.git/(info/refs|git-upload-pack|git-receive-pack|HEAD|objects/|info/lfs)")
	}
	handle @machine {
		reverse_proxy forgejo:3000
	}

	# Forgejo's logout only ends Forgejo's own session; oauth2-proxy and Keycloak would sign the user straight
	# back in on the next request. Forgejo answers the logout request with JSON ({"redirect":"/"}) that its
	# page script follows, so let it clear its cookies as usual but swap that JSON for one that goes through
	# oauth2-proxy's sign-out and then Keycloak's logout. Needs no login header: the session cookie is enough.
	# Override KEYCLOAK_LOGOUT_RD (the URL-encoded Keycloak logout endpoint) for another realm.
	@logout path /user/logout
	handle @logout {
		reverse_proxy forgejo:3000 {
			@done status 2xx
			handle_response @done {
				copy_response_headers {
					exclude Content-Length
				}
				respond `{"redirect":"/oauth2/sign_out?rd={$KEYCLOAK_LOGOUT_RD:https%3A%2F%2Fauth.htl-leonding.ac.at%2Frealms%2Fhtlleonding%2Fprotocol%2Fopenid-connect%2Flogout}"}` 200
			}
		}
	}

	# Everything else is a browser: sign in with Keycloak, then hand Forgejo the IF number.
	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-Preferred-Username>X-WEBAUTH-USER

			# /oauth2/auth answers 401 when nobody is signed in; Caddy would hand that to the browser as is.
			# Send it to Keycloak instead, and back to the page it asked for afterwards.
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /oauth2/start?rd={http.request.uri.path_escaped}%3F{http.request.uri.query_escaped}
			}
		}

		reverse_proxy forgejo:3000
	}
}
